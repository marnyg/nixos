 				break
 			}
-			keys = append(keys, key)
+			log.Infof("discovered legacy indexed DNS key (no interface scope): %s", legacyKey)
+			keys = append(keys, legacyKey)
 		}
 	}
 
-	return keys
+	return keys, nil
 }
 
